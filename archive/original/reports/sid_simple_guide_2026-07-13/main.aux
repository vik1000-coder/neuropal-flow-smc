\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Median held-out NLL reduction relative to the tested heteroscedastic Gaussian. The winning normalized model was the eight-component autoregressive MDN in all four systems.}}{7}{figure.caption.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Did the methods recover the history effect?}{8}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Bars are eight-cell medians; dots are the individual frozen cells and error bars are interquartile ranges. Blue uses the best clean infinitesimal route, which was the ratio critic in G1--G4. Orange uses the best clean finite typed route at $\delta =0.12$. The routes differ because each column asks for the best estimator of its declared quantity.}}{8}{figure.caption.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Why diffusion looked better than it really was}{9}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Legacy diffusion at standardized response noise $\sigma =0.12$. A low response-score NRMSE evaluates the native denoising target. The model-centered history tangent is the implementable SID quantity. The two errors decouple sharply for skew and separated modes.}}{9}{figure.caption.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}System-by-system verdict}{10}{subsection.5.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}The hard G8 check: a pure fourth-order path effect}{10}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Median fraction of the true G8 typed effect recovered. The best raw full-law generator was the MDN (slope 0.060); the best guided frozen generator was EDM (0.398); the best endpoint expert was EDM (0.336). A direct classifier on the raw path recovers 0.969, and the motif-aligned classifier recovers 1.001.}}{11}{figure.caption.6}\protected@file@percent }
