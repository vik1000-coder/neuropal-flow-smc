\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Revised gate matrix after failure adjudication. ``Conditional'' always refers to the tested access/model/horizon regime.}}{2}{table.caption.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Method families, quantities, and fair roles.}}{3}{table.caption.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}What the methods estimate}{3}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Access-tier discipline}{3}{subsection.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Validation and audit trail}{3}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces E1. ORTH improves inference rather than point accuracy on the regular Gaussian reference; a direct mean head is strongest when the target is known.}}{4}{figure.caption.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces E2--E3. Controlled product-order nuisance bias and stable one-future-per-history estimation; temporal dependence requires blocked splitting and HAC uncertainty.}}{4}{figure.caption.7}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}The original result landscape}{4}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces E4. The default low-frequency bank missed a designed high-order departure; a frozen resolving bank detected it on new seeds.}}{5}{figure.caption.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces E5. Weak-feature derivatives remain stable through deterministic support motion; the likelihood-score route scales like $1/\sigma $ and becomes undefined.}}{5}{figure.caption.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces E7 and E11. History resolution reveals cancellation; future-path features recover ordering invisible to endpoint/unordered summaries.}}{5}{figure.caption.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces E6 sample scaling. In Student-$t_3$ and gaps 3--4, the density-score learner improves with data while the targeted fixed sieve reaches a bias floor. The oracle curve shows that severe overlap also increases variance.}}{6}{figure.caption.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Gap-4 diagnosis. The alternative representer learner lowers nuisance NRMSE from about 0.966 to 0.029 and restores empirical target coverage; the original sieve's shrinking standard errors expose its fixed bias.}}{6}{figure.caption.12}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}E6 adjudication: the representer learner failed}{6}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Why the original sieve could not be rescued by $n$ alone}{6}{subsection.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}What was changed}{6}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces E8 at $\rho =.98$. Longer observation windows change the conditioning enough to make exact characteristic recovery useful. Sample size helps only after the horizon crosses that information threshold.}}{7}{figure.caption.13}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Results and conclusion}{7}{subsection.5.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}E8 adjudication: a measurement inverse problem}{7}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}What was wrong with the first correction}{7}{subsection.6.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}What was added}{7}{subsection.6.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Results and conclusion}{7}{subsection.6.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Known-filter cells: maximum inverse attenuation tracks the error regime. This diagnostic should be reported before interpreting a corrected latent effect.}}{8}{figure.caption.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces E9 oracle readout. Four orders of magnitude in ridge mattered more than increasing the query count. Oracle sweeps diagnose readout bias separately from feature-estimation noise.}}{9}{figure.caption.15}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}E9 adjudication: synthetic rank, inversion ridge, and target choice}{9}{section.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}The nominal rank-three generator was rank two}{9}{subsection.7.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}The characteristic inverse was over-regularized}{9}{subsection.7.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.3}What succeeds after correction}{9}{subsection.7.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces E9 diagnosis. Identified geometry and corrected inverse ridge convert the typed covariance result from apparent failure to sample-scaling success. Low-rank structure is essential at response dimension 32.}}{10}{figure.caption.16}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}Baseline completeness and the generative-model tangent}{10}{section.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}Core equal-target baselines}{10}{subsection.8.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}Flexible reusable-law baselines}{10}{subsection.8.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces E10 mean tangent NRMSE from the original complete local tournament. Bold is the lowest mean, not necessarily a statistically decisive winner.}}{11}{table.caption.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces E10. ORTH wins the pooled local-budget comparison and the moment-blind/path families. Analytic MDNs have lower means in some smooth or typed cells; no method is universal.}}{11}{figure.caption.18}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}Diffusion, denoising-score, flow-matching, and finite contrasts}{11}{subsection.8.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Earlier stabilized score/generative benchmark. Native training stability and sample quality were insufficient guarantees for the history-tangent target. The grid and estimand differ from E10, so this is context rather than a new paired comparison.}}{12}{figure.caption.19}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Best-supported choice by scientific subproblem.}}{13}{table.caption.20}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {9}Consolidated method choice}{13}{section.9}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10}Theory and empirical synthesis}{13}{section.10}\protected@file@percent }
